// knip: reports unused files, exports and dependencies (spec §5).
// ui/*.tsx are shadcn-owned primitives consumed from Phase 2; lucide-react is their icon set; hooks are run by Claude Code; scripts run from npm scripts or by hand (images, captures, headers, visual-check).
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/components/ui/*.tsx",
    ".claude/hooks/*.mjs",
    "scripts/*.mjs",
    "scripts/capture/*.mjs"
  ],
  "ignoreDependencies": ["lucide-react"]
}
