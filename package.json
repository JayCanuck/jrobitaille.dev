{
  "name": "jrobitaille.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/headers.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:lint": "designmd lint DESIGN.md",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "e2e": "playwright test",
    "images": "node scripts/images.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "lighthouse": "lhci autorun",
    "check": "npm run format:check && npm run design:lint && npm run lint && npm run knip && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@google/design.md": "^0.4.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "quoteProps": "preserve",
    "trailingComma": "none",
    "arrowParens": "avoid",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/styles/globals.css"
  }
}
